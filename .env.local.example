# These variables should be set your EAS project
# Then run `eas env:pull development` to generate the .env.local file that looks like this

APP_ENV=***
EXPO_PUBLIC_AUTH_API_URL=http://***
# Leave both empty to use local dummy data. Set both to use Supabase again.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SENTRY_DSN=***
SENTRY_AUTH_TOKEN=***